# Answers `eas credentials:configure-build` prompts so credentials can be set
# up from a script. Apple auth comes from the App Store Connect API key in
# the environment (docs/phone-testing.md, "Apple credentials"); it exits if
# EAS asks for an Apple ID or password instead.
# Usage: expect scripts/eas-credentials.exp <build profile> [ios|android]
# The development:client profiles build Rodge Dev (APP_VARIANT, see
# app.config.ts), which has its own bundle ID and credentials.
set timeout 300
set profile [lindex $argv 0]
set platform [expr {[llength $argv] > 1 ? [lindex $argv 1] : "ios"}]
set variant [expr {[string match "development:client*" $profile] ? "development" : ""}]
log_user 1
spawn env APP_VARIANT=$variant eas credentials:configure-build -p $platform -e $profile
expect {
  -re {\(Y/n\)} { send "y\r"; exp_continue }
  -re {\(y/N\)} { send "y\r"; exp_continue }
  -re {Apple ID:} { send_user "\n!!! ASKED FOR APPLE ID\n"; exit 3 }
  -re {Password} { send_user "\n!!! ASKED FOR PASSWORD\n"; exit 3 }
  -re {Return to submit} { send "\r"; exp_continue }
  -re {Space to select} { send "a\r"; exp_continue }
  timeout { send_user "\n!!! TIMEOUT\n"; exit 2 }
  eof
}
catch wait result
exit [lindex $result 3]
